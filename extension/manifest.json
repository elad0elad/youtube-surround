{
  "manifest_version": 3,
  "name": "YouTube Surround",
  "version": "1.2.1",
  "description": "Plays real YouTube IAMF as direct 5.1, a spatial bed, or a stereo downmix. © elad0elad",
  "author": "elad0elad",
  "homepage_url": "https://github.com/elad0elad/youtube-surround",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Surround",
    "default_popup": "popup.html"
  },
  "key": ""
}
